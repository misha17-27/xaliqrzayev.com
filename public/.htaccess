# xaliqrzayev.com — public/ (cPanel-də public_html) üçün Apache / LiteSpeed qaydaları

Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Alt qovluqda yerləşdirsəniz:
    # RewriteBase /qovluq/

    # HTTPS və www-suz ünvan — SSL sertifikatı aktiv olandan sonra açın
    # RewriteCond %{HTTPS} off [OR]
    # RewriteCond %{HTTP_HOST} ^www\. [NC]
    # RewriteRule ^ https://xaliqrzayev.com%{REQUEST_URI} [L,R=301]

    # Köməkçi giriş faylı birbaşa açılmır
    RewriteRule ^_init\.php$ - [R=404,L]

    # /index.php → /
    RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [L,R=301]

    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|log|sql|bak|md|ini)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|gif|svg|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
