# Admin qovluğunun qorunması

# Konfiqurasiya və köməkçi fayllara birbaşa giriş bağlıdır
<FilesMatch "^(config\.php|config\.sample\.php|db\.php|schema\.php|lib\.php)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(json|sql|sqlite|bak|log)$">
    Require all denied
</FilesMatch>

Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Cache-Control "no-store"
</IfModule>
