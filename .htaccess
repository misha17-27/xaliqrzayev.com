# Ehtiyat rejim: layihə bütövlükdə public_html-ə yüklənibsə,
# bütün sorğular public/ qovluğuna yönləndirilir — app/, config/, storage/ veb-dən görünmür.
# Tövsiyə olunan yerləşdirmə isə .cpanel.yml-dəkidir (public/ → public_html).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
Options -Indexes
